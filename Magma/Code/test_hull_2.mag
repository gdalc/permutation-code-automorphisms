q := 2; //finite field size
n_test := 3; //number of tests for each value of k
Fq := GF(q);
//file used for writing the results
f:=Open("file_path","w");
Write(f, "k, Our, BuiltIn\n");

//function to find code automorphisms when the hull is trivial that relies on finding graph automorphisms
function Auto(G)
	A :=Transpose(G)*(G*Transpose(G))^-1*G;
	n_col:=Ncols(G);
	graph := Digraph<n_col|MatrixRing(Integers(), n_col)!A>;
	auto_group :=  AutomorphismGroup(graph); 
	return auto_group;
end function;

//function to find code automorphisms that fix the two information sets J1 and J2, relying on graph automorphism search
function Auto_stab(G,J1,J2)
	A :=Transpose(G)*(G*Transpose(G))^-1*G;
	n_col:=Ncols(G);
	J2:=[j+(n_col/2) : j in J2];
	J_tot:= Seqset(J1) join Seqset(J2);
	graph := Digraph<n_col|MatrixRing(Integers(), n_col)!A>;
	V:= Vertices(graph);
	J_tot:= Setseq(J_tot);
	St:=[];
	for i in [1..#J_tot] do
		Append(~St, {V|Integers()!J_tot[i]});
	end for;
	auto_group :=  AutomorphismGroup(graph : Stabilizer:=St); 
	return auto_group;
end function;

//shorten the code on coordinates in U without deleting columns
function ShortenedCode(G, U, Fq)
	n := Ncols(G);
	k := Nrows(G);
	C:= LinearCode(G);
	H:= ParityCheckMatrix(C);
	H_shorten := ZeroMatrix(Fq, n - k + #U, n);
	InsertBlock(~H_shorten, H, 1, 1);
	for i in [1..#U] do
		H_shorten[n-k+i,U[i]] :=1;
	end for;
return ParityCheckMatrix(LinearCode(H_shorten));
end function;

//Samples permutation if length n = 2*k and with order k
function sample_perm_order(k)
	S2k := Sym(2*k);
	//generate a permutation of S_{2*k} and write it in sequence form
	P := Eltseq(Random(S2k)); 
	cycles:=[];
	for i in [1..k-1] do
		cycles[P[i]] := P[i+1];
	end for;
	cycles[P[k]]:=P[1];

	for i in [1..k-1] do
		cycles[P[k+i]]:=P[k+i+1];
	end for;
	cycles[P[2*k]]:=P[k+1];
	perm:=S2k!cycles;
return perm, PermutationMatrix(Integers(),perm);
end function;

//generate random code whose automorphism group contains P (and its powers). 
//P is sampled as a permutation of length n and order k
function gen_code(Fq, n, k)
	ok := 0;
	while (ok eq 0) do
		cycles, P := sample_perm_order(k);
		P:=ChangeRing(P, Fq);
		G := ZeroMatrix(Fq, k, n);
		a := Vector(Fq, [Random(Fq) : i in [1..n]]);
		G[1]:=a;
		for i in [2..k] do
            		a := a*P;
			G[i]:=a;
		end for;
		if (Rank(G) eq k) then
              		ok := 1;
		end if;
	end while;
	S := RandomMatrix(Fq,k,k);
	while (Rank(S) lt k) do
		S := RandomMatrix(Fq,k,k);
	end while;
	return cycles, P, S*G;
end function;

//check if P is an authomorphism of the code generated by G
function is_an_auto(P,G,H,n,k)
	if (Rank(P) eq n) then
		P:=ChangeRing(P, Fq);
		if (G*P*Transpose(H) eq ZeroMatrix(Fq,k,k)) then
			return 1;
		end if;
	end if;
	return 0;
end function;

//function for slecting the value of k for which it is easy to find a code with a hull_dim of dimension 2
function select_k_values(min,max,hull_dim)
k_set := [];
for k in [min.. max] do
	n:=2*k;
	h:= 2000;
	num_attempts:= 0;
	while h ne hull_dim do
		num_attempts := num_attempts+1;
		cycles, P, G := gen_code(Fq, n, k);
		h := k-Rank(G*Transpose(G));
		if num_attempts gt 10000 then
			break;
		end if;
	end while;
	if h eq hull_dim then
		Append(~k_set, k);
	end if;
end for;
return k_set;
end function;


//k_set := select_k_values(30,100,2);


for k in [30, 33, 34, 36, 38, 39, 42, 45, 46, 48, 50, 51, 54, 57, 58, 60, 62, 63, 66, 69, 70, 72, 74, 75, 78, 81, 82, 84, 86, 87, 90, 93, 94, 96, 98, 99 ] do
	n := 2*k;
	time_our :=0; //time for our solver
	builtin_time :=0; //time for built-in function


	for test in [1..n_test] do
		h:= 0;
		//generate a code with hull dimension 2, length n and dim k
		while h ne 2 do
			cycles, P, G := gen_code(Fq, n, k);
			h := k-Rank(G*Transpose(G));
		end while;
			C := LinearCode(G);
			H:=ParityCheckMatrix(C);
		
			//magma buit-in algorithm
			t1:= Cputime();
			perm_gr:=PermutationGroup(C);
			magma := Cputime(t1);
			builtin_time := builtin_time + magma;
			
			//our reduction
			true_automorphisms := {}; 
			t2:= Cputime();
			hullC:= Hull(C);
			AllIS:= AllInformationSets(hullC);
			J:= AllIS[1];
			G1:= ShortenedCode(G, J, Fq);
			//reduction part
			for Jfirst in AllIS do
				G2:= ShortenedCode(G, Jfirst, Fq);
				M:= DiagonalJoin(G1,G2);
				C_prod:= LinearCode(M);
				M_auto_group:= Auto_stab(M,J,Jfirst);
				for perm in M_auto_group do
						if perm ne Id(M_auto_group) then
							P_prod :=PermutationMatrix(Integers(),perm);
							P := Submatrix(P_prod,1,n+1,n,n);
							P[J[1],Jfirst[1]]:=1;
							P[J[2],Jfirst[2]]:=1;
							if is_an_auto(P,G,H,n,k) eq 1 then
								Include(~true_automorphisms, ChangeRing(P, Fq));
							else 
								P := Submatrix(P_prod,1,n+1,n,n);
								P[J[1],Jfirst[2]]:=1;
								P[J[2],Jfirst[1]]:=1;
								if is_an_auto(P,G,H,n,k) eq 1 then
									Include(~true_automorphisms, ChangeRing(P, Fq));
								end if;
							end if;
						end if;
				end for;
			end for;
			our := Cputime(t2);
			time_our := time_our + our;
			
		/*
		//sanity check
		auto:=[];
		my_auto_matrices := {PermutationMatrix(Fq,perm) : perm in perm_gr};
		my_auto_matrices eq true_automorphisms;
		#my_auto_matrices;
		#true_automorphisms;
		*/
	end for;
fprintf f, "%o, %o, %o\n", k, RealField()!(our_time/n_test), RealField()!(builtin_time/n_test);
end for;
delete f;
